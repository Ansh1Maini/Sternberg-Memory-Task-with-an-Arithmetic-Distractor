        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="&amp;#10;&amp;#10;&amp;#10;&amp;#10;On each trial, you will see a group of digits.&amp;#10;Remember all of them.&amp;#10;Then the digits will disappear, followed by a short arithemetic problem, you'll have to solve.&amp;#10;Then a single test digit will appear&amp;#10;Your job: decide whether the test digit &amp;#10;was one of the digits you just saw.&amp;#10;&amp;#10;Press &quot;y&quot; if you think that the single digit belonged to the original set of digits and press &quot;n&quot; if you think that the single digit did not belong to the original set of digits.&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;Press SPACE to continue." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
